root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

[*.{json,yml,yaml,props,targets,csproj,slnx,xml,md}]
indent_size = 2

[Makefile]
indent_style = tab

[*.cs]
csharp_style_namespace_declarations = file_scoped:error
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_using_directive_placement = outside_namespace:error
dotnet_sort_system_directives_first = true
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_switch_expression = true:suggestion

# Naming (CC-011)
dotnet_naming_rule.interfaces_prefix.symbols = interfaces
dotnet_naming_rule.interfaces_prefix.style = i_prefix
dotnet_naming_rule.interfaces_prefix.severity = error
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.i_prefix.required_prefix = I
dotnet_naming_style.i_prefix.capitalization = pascal_case

dotnet_naming_rule.constant_fields.symbols = constant_fields
dotnet_naming_rule.constant_fields.style = pascal_case
dotnet_naming_rule.constant_fields.severity = error
dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.static_readonly_fields.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields.style = pascal_case
dotnet_naming_rule.static_readonly_fields.severity = error
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly

dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel
dotnet_naming_rule.private_fields.severity = error
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, internal, private_protected
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# Code metrics (CC-002)
dotnet_diagnostic.CA1502.severity = warning
dotnet_code_quality.CA1502.threshold = 15

# Library projects: ConfigureAwait(false) is enforced in review (CC-009); not by analyzer
dotnet_diagnostic.CA2007.severity = none
# Noisy for an application (not a localized library)
dotnet_diagnostic.CA1303.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1062.severity = none
# Sealed/internal-by-default is handled by CC-010 and ARC-001 tests
dotnet_diagnostic.CA1812.severity = none
# Meziantou/Sonar rules that conflict with the spec
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.S1075.severity = none
dotnet_diagnostic.S125.severity = suggestion

# Marker types and small grouped records are intentional
dotnet_diagnostic.S2094.severity = none
dotnet_diagnostic.MA0048.severity = none
# XML namespace URIs are identifiers, not network calls
dotnet_diagnostic.S5332.severity = none
dotnet_diagnostic.S3267.severity = none
# CA1508 misreads union switch arms as always-true
dotnet_diagnostic.CA1508.severity = none
# Binary payload records (resource, checksum) intentionally expose byte[]
dotnet_diagnostic.CA1819.severity = none
# Internal control-flow exceptions, ordinal == on strings, and union patterns (a is false) trip these
dotnet_diagnostic.CA1032.severity = none
dotnet_diagnostic.CA1064.severity = none
dotnet_diagnostic.S3376.severity = none
dotnet_diagnostic.S3871.severity = none
dotnet_diagnostic.S1125.severity = none
dotnet_diagnostic.MA0006.severity = none
dotnet_diagnostic.CA1030.severity = none
dotnet_diagnostic.CA2227.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1724.severity = none
dotnet_diagnostic.CA5394.severity = none
dotnet_diagnostic.CA1826.severity = none
dotnet_diagnostic.S6608.severity = none
dotnet_diagnostic.MA0016.severity = none
# Dapper populates row DTO properties by reflection
dotnet_diagnostic.S1144.severity = none
# Compiler-generated union structs do not override Equals
dotnet_diagnostic.CA1815.severity = none

[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.MA0051.severity = none
dotnet_diagnostic.S2699.severity = none
dotnet_diagnostic.S3881.severity = none
dotnet_diagnostic.xUnit1051.severity = none
dotnet_diagnostic.MA0006.severity = none
dotnet_diagnostic.CA1030.severity = none
dotnet_diagnostic.CA2227.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1724.severity = none
dotnet_diagnostic.CA5394.severity = none
dotnet_diagnostic.CA1826.severity = none
dotnet_diagnostic.S6608.severity = none
dotnet_diagnostic.MA0016.severity = none
dotnet_diagnostic.MA0002.severity = none
dotnet_diagnostic.CA2100.severity = none
dotnet_diagnostic.CA2234.severity = none
dotnet_diagnostic.CA2000.severity = none
